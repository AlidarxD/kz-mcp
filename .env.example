# Copy to .env for local development. Never commit .env.
KZ_MCP_LOG_LEVEL=INFO

# Legal retrieval: auto | kz-law | fixture
KZ_MCP_RETRIEVER=auto
# kz-law-llm data directory (contains chunks/ and qdrant/)
KZ_MCP_LAW_DATA_DIR=../kz-law-llm/data
# bm25 | dense | hybrid, optionally +rerank
KZ_MCP_LAW_METHOD=hybrid+rerank
KZ_MCP_LAW_EMBEDDING_MODEL=e5-base-int8
# KZ_MCP_LAW_QDRANT_URL=http://localhost:6333
# KZ_MCP_LAW_MODELS_CACHE_DIR=./models
# KZ_MCP_LAW_ONNX_THREADS=4
KZ_MCP_LAW_WARMUP=false
